# Copy to .env and fill in. Never commit .env.

# rotating | list | none
WEBSHARE_MODE=rotating

# --- rotating mode: Webshare dashboard -> Proxy List -> "Rotating Proxy Endpoint"
# Use the username exactly as shown there (it usually ends in -rotate).
WEBSHARE_PROXY_USERNAME=yourusername-rotate
WEBSHARE_PROXY_PASSWORD=yourpassword
# WEBSHARE_PROXY_HOST=p.webshare.io
# WEBSHARE_PROXY_PORT=80

# --- list mode: Webshare dashboard -> API -> API Keys
WEBSHARE_API_KEY=
# Optional: only use proxies in these countries (comma separated ISO codes), e.g. IN,SG
WEBSHARE_COUNTRIES=

# --- hosting: cloudflare (Cloudflare Pages, default) or github (GitHub Pages)
HOSTING=cloudflare
# CF_PAGES_PROJECT=bhaau
# Cloudflare API token with the permission Account / Cloudflare Pages / Edit
# (https://dash.cloudflare.com/profile/api-tokens). scripts/deploy.py asks for it and fills these in.
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=

# --- your website's public address (no trailing slash). Used for Google:
# canonical links, sitemap.xml, robots.txt. Examples:
#   SITE_URL=https://bhaau.com.np
#   SITE_URL=https://bhaau.pages.dev    (filled in by scripts/deploy.py)
SITE_URL=

# --- public contact address: footer "Contact" and "Report a wrong price" links, privacy page.
# Use an address you're happy to show publicly (not your personal one, ideally).
CONTACT_EMAIL=

# --- price-drop alerts (optional). The Cloudflare Worker in alerts/, see README.
# ALERTS_URL=https://bhaau-alerts.yourname.workers.dev
# ALERTS_TOKEN=the-same-long-random-string-you-gave-the-worker

# --- "store broke" emails + private status page (optional, see README "Keeping it healthy")
# Free key from https://resend.com (the same one the alerts Worker uses is fine).
# RESEND_API_KEY=re_xxxxxxxx
# Where problem emails go:
# OWNER_EMAIL=you@example.com
# Sender. Must be on a domain you verified in Resend; leave empty to use Resend's test sender.
# MAIL_FROM=Bhaau <alerts@yourdomain.com>
# Secret part of the status page address: https://<your site>/status-<STATUS_KEY>/
# 12-80 letters, digits, - or _. Make one with:  python -c "import secrets;print(secrets.token_urlsafe(18))"
# STATUS_KEY=

# --- visitor stats (optional): Cloudflare Web Analytics, no cookies. Cloudflare dashboard ->
# Analytics & Logs -> Web Analytics -> Add a site -> your site address -> copy the token from the snippet.
# CF_ANALYTICS_TOKEN=
